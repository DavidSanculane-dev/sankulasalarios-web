# ---- Supabase ----
# Vai a Project Settings > Database > Connection string (modo "Transaction pooler")
# Isto é ESSENCIAL em serverless (Vercel) - a ligação direta esgota as conexões rapidamente.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Ligação direta (só usada por drizzle-kit para migrations, não pela app)
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxxx"

# ---- Suprema BioStar 2 ----
# Usado pelo cron de sincronização (a Suprema não faz push, o servidor BioStar 2 é que é consultado)
BIOSTAR_BASE_URL="https://ip-do-teu-servidor-biostar:443"
BIOSTAR_USERNAME="admin"
BIOSTAR_PASSWORD=""

# Segredo partilhado para autenticar o cron job da Vercel
CRON_SECRET="gera-um-valor-aleatorio-aqui"
